<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 连 PC 的 12570(HTTP) / 12670(TCP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台服务以媒体播放类型运行：Android 14（API 34）强制前台服务必须声明类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 来源端要长时间拿着麦克风，前台服务必须同时声明 microphone 类型；
         光有 RECORD_AUDIO 不够——targetSdk 34 起，前台服务在后台访问麦克风要求类型匹配 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 内录（AudioPlaybackCapture）走的是系统弹框授权，与 RECORD_AUDIO 是两条独立的路：
         它不需要录音权限，但取 MediaProjection 之前必须以 mediaProjection 类型进前台，
         否则 Android 14 起会被系统直接拒绝，而那时用户刚点完同意 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 来源端要采麦克风（目标二），先声明；运行时还会再要一次授权 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 音频链路跑在前台服务里，锁屏与切后台都不能断声 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 硬件加速保持默认开启（这里刻意不再写 android:hardwareAccelerated="false"）。
         曾经关掉它，是因为 Activity.onCreate 里调了 startForegroundService 而系统只给 5 秒，
         图形栈慢或半坏的设备（模拟器、部分定制机）上首帧画不出来就必然 ANR。
         那个根因已经换掉了：打开界面只 bindService，转前台推迟到用户真的点「连接」时，
         不存在「必须在 5 秒内画出第一帧」这个前提了。
         而 Material 的圆角、阴影与滑块拖动都依赖硬件加速，软件渲染下会退化成没有阴影、拖动发涩，
         两相权衡恢复默认。 -->
    <!-- 图标与 PC 端是同一张：tools\IconTool.java 把 dist\icon.ico 转成各密度的 PNG 与
         adaptive 前景，背景渐变也从那张图上下缘采样得来。换图标就重新跑一遍那个工具。
         roundIcon 指向同一个资源：Android 7.1 起部分启动器会优先用它，而这张图本身的形状
         已经接近圆角方形，裁圆后不丢内容。 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioStream"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic：协议就是局域网里的裸 HTTP，没有 TLS，
             Android 9 起默认禁明文，不禁用这一项连设备列表都拉不到 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AudioStreamService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone|mediaProjection" />
    </application>

</manifest>
